@prefix ceon-product:  <http://w3id.org/CEON/ontology/product/> .
@prefix dpp-core:      <http://w3id.org/dppo/ontology/dpp-core/> .
@prefix dpp-info:      <http://w3id.org/dppo/ontology/dpp-info/> .
@prefix dpp-odp:       <http://w3id.org/dppo/ontology/dpp-odp/> .
@prefix resourceODP:   <http://w3id.org/CEON/ontology/resourceODP/> .
@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix glass: <https://w3id.org/glass/ontology/> .
@prefix ifc:   <https://standards.buildingsmart.org/IFC/DEV/IFC4/ADD2/OWL#> .
@prefix qudt:  <http://qudt.org/schema/qudt/> .
@prefix quantitykind:  <https://qudt.org/vocab/quantitykind/> .
@prefix quantityunit: <http://qudt.org/vocab/unit/> .
@prefix ex:    <http://example.org/> .

# ====================
# Classes (14 concepts)
# ====================

ceon-product:MatterComposition a owl:Class .
resourceODP:BatchOfObjects a owl:Class .

ifc:BuiltElement a owl:Class .

glass:Window a owl:Class ;
    rdfs:subClassOf ifc:BuiltElement .

glass:WindowGlass a owl:Class ;
    rdfs:subClassOf ifc:BuiltElement .

glass:WindowFrame a owl:Class ;
    rdfs:subClassOf ifc:BuiltElement .

dpp-odp:DPP a owl:Class .

dpp-odp:Product a owl:Class .

dpp-core:Substance a owl:Class ;
    rdfs:subClassOf dpp-odp:Product .

dpp-info:DPPInformation a owl:Class .

dpp-info:CompositionInformation a owl:Class ;
    rdfs:subClassOf dpp-info:DPPInformation .

dpp-info:ProductCharacteristic a owl:Class ;
    rdfs:subClassOf dpp-info:DPPInformation .

qudt:QuantityKind a owl:Class .

qudt:Unit a owl:Class .

# ====================
# Instances & Relationships
# ====================

# _a: a product that is a window
ex:_a a ceon-product:Item , glass:Window ;
    glass:numberOfPanes "2"^^xsd:integer .

# palletDPP_1: the Digital Product Passport
ex:palletDPP_1 a dpp-odp:DPP ;
    dpp-odp:describes ex:_a ;
    dpp-info:containsInformation ex:_c , ex:_d , ex:_e , ex:_f .

# _c: composition information about the window
ex:_c a dpp-info:CompositionInformation ;
    dpp-info:hasWhole ex:_a ;
    dpp-odp:hasPart ex:_g , ex:_h , ex:_i .

# _g and _h: window glass parts
ex:_g a glass:WindowGlass .

ex:_h a glass:WindowGlass .

# _i: window frame part
ex:_i a glass:WindowFrame .

# _e: product characteristic about _g (thickness = 2 mm)
ex:_e a dpp-info:ProductCharacteristic ;
    dpp-info:isAbout ex:_g ;
    dpp-info:value "2"^^xsd:integer ;
    qudt:hasQuantityKind quantitykind:Thickness ;
    qudt:unit quantityunit:MilliM .

# _d: product characteristic about _h (thickness = 3 mm)
ex:_d a dpp-info:ProductCharacteristic ;
    dpp-info:isAbout ex:_h ;
    dpp-info:value "3"^^xsd:integer ;
    qudt:hasQuantityKind quantitykind:Thickness ;
    qudt:unit quantityunit:MilliM .

# _f: matter composition of the frame
ex:_f a ceon-product:MatterComposition ;
    ceon-product:compositionOf ex:_i ;
    ceon-product:associatedWithMatter ex:ALU .

# ALU: a substance (aluminium)
ex:ALU a dpp-core:Substance .

# Quantity kind and unit instances
quantitykind:Thickness a qudt:QuantityKind .

quantityunit:MilliM a qudt:Unit .
