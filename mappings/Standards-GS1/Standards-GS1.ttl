@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

owl:annotatedProperty a rdf:Property .

owl:annotatedSource a rdf:Property .

owl:annotatedTarget a rdf:Property .

<https://w3id.org/dpp/alignment/standards-gs1/> a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist",
        "Huanyu Li",
        "Rahel Kebede" ;
    dcterms:created "2026-01-23"^^xsd:date ;
    dcterms:creator "Rahel Kebede" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:source "https://github.com/RichZele/DPP-DPPO-CEON-Ontology-Alignment/blob/main/documentations/Standards-GS1.xlsx" ;
    dcterms:title "The alignment ontology between the DPP, DPPO and CEON ontologies and the GS1 Web Vocabulary" ;
    rdfs:comment "This ontology represents the alignment between the DPP, DPPO and CEON ontologies and the GS1 Web Vocabulary." ;
    owl:versionInfo "0.1" .

<https://w3id.org/dpp/alignment/standards-gs1/GS1_0001> a sssom:Mapping ;
    dc:identifier "GS1_0001" ;
    dcterms:source "https://w3id.org/dpp/alignment/standards-gs1/" ;
    rdfs:comment "gs1:Product is any item, product or service, for which predefined information must be retrievable and that may be priced, ordered or invoiced. dpp:Product is a physical artefact and therefore satisfies the broader commercial definition. Stated in the GS1 section of the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dpp#Product> ;
    owl:annotatedTarget <https://www.gs1.org/voc/Product> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Product" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Product" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/standards-gs1/GS1_0002> a sssom:Mapping ;
    dc:identifier "GS1_0002" ;
    dcterms:source "https://w3id.org/dpp/alignment/standards-gs1/" ;
    rdfs:comment "gs1:Product is strictly broader than the DPPO product class, so only a subclass axiom is justified. Stated in the GS1 section of the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-odp/Product> ;
    owl:annotatedTarget <https://www.gs1.org/voc/Product> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Product" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Product" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/standards-gs1/GS1_0003> a sssom:Mapping ;
    dc:identifier "GS1_0003" ;
    dcterms:source "https://w3id.org/dpp/alignment/standards-gs1/" ;
    rdfs:comment "gs1:Product is strictly broader than the CEON product class, so only a subclass axiom is justified. Stated in the GS1 section of the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/CEON/ontology/product/Product> ;
    owl:annotatedTarget <https://www.gs1.org/voc/Product> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Product" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Product" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/standards-gs1/GS1_0005> a sssom:Mapping ;
    dc:identifier "GS1_0005" ;
    dcterms:source "https://w3id.org/dpp/alignment/standards-gs1/" ;
    rdfs:comment "CEON provides a literal-valued property for the GTIN carrying an rdfs:seeAlso reference to the GS1 standard. The two are not interchangeable. gs1:gtin is declared functional and declares gs1:Product and schema:Product as conjunctive domains, while the CEON property imposes neither constraint, so an equivalence would transfer both to CEON. The more constrained GS1 property is therefore aligned as a subproperty of the less constrained CEON property. Stated in the section on semantic alignment with the GS1 family of standards in the accompanying paper." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <https://www.gs1.org/voc/gtin> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/product/hasGlobalTradeItemNumber> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "hasGlobalTradeItemNumber" ;
    sssom:object_type owl:DatatypeProperty ;
    sssom:subject_label "gtin" ;
    sssom:subject_type owl:DatatypeProperty .

<http://w3id.org/CEON/ontology/product/Product> a owl:Class ;
    rdfs:subClassOf <https://www.gs1.org/voc/Product> .

<http://w3id.org/dpp#Product> a owl:Class ;
    rdfs:subClassOf <https://www.gs1.org/voc/Product> .

<http://w3id.org/dppo/ontology/dpp-odp/Product> a owl:Class ;
    rdfs:subClassOf <https://www.gs1.org/voc/Product> .

<https://www.gs1.org/voc/gtin> a owl:DatatypeProperty ;
    rdfs:subPropertyOf <http://w3id.org/CEON/ontology/product/hasGlobalTradeItemNumber> .

<http://w3id.org/CEON/ontology/product/hasGlobalTradeItemNumber> a owl:DatatypeProperty .

<https://www.gs1.org/voc/Product> a owl:Class .

