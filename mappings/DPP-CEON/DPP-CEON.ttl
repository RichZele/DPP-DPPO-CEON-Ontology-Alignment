@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

owl:annotatedProperty a rdf:Property .

owl:annotatedSource a rdf:Property .

owl:annotatedTarget a rdf:Property .

<https://w3id.org/dpp/alignment/dpp-ceon/> a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist",
        "Huanyu Li",
        "Rahel Kebede" ;
    dcterms:created "2026-01-23"^^xsd:date ;
    dcterms:creator "Rahel Kebede" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:source "https://github.com/RichZele/DPP-DPPO-CEON-Ontology-Alignment/blob/main/documentations/DPP-CEON.xlsx" ;
    dcterms:title "The alignment ontology between the DPP ontology and CEON" ;
    rdfs:comment "This ontology represents the alignment between the Digital Product Passport (DPP) ontology and the Circular Economy Ontology Network (CEON)." ;
    owl:versionInfo "0.1" .

<https://w3id.org/dpp/alignment/dpp-ceon/DPP_CEON_0002> a sssom:Mapping ;
    dc:identifier "DPP_CEON_0002" ;
    dcterms:source "https://w3id.org/dpp/alignment/dpp-ceon/" ;
    rdfs:comment "Both properties relate a product to a component that is itself a product. Additional mapping, not discussed in the paper." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <http://w3id.org/dpp#hasComponent> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/product/hasProductComponent> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "hasProductComponent" ;
    sssom:object_type owl:ObjectProperty ;
    sssom:subject_label "hasComponent" ;
    sssom:subject_type owl:ObjectProperty .

<https://w3id.org/dpp/alignment/dpp-ceon/DPP_CEON_0003> a sssom:Mapping ;
    dc:identifier "DPP_CEON_0003" ;
    dcterms:source "https://w3id.org/dpp/alignment/dpp-ceon/" ;
    rdfs:comment "The DPP and DPPO material classes apply different classification criteria, so no direct correspondence between them is justified. Both are instead related to ceon-material:Material, which CEON defines as a subclass of Matter requiring at least one associated chemical entity. Stated in the section on the semantic alignment of core classes in the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dpp#Material> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/material/Material> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Material" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Material" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dpp-ceon/DPP_CEON_0004> a sssom:Mapping ;
    dc:identifier "DPP_CEON_0004" ;
    dcterms:source "https://w3id.org/dpp/alignment/dpp-ceon/" ;
    rdfs:comment "Both classes reify a composition relation. The general CEON composition class is used rather than ceon-product:MatterComposition, because the DPP ontology does not impose the restriction that every instance be associated with exactly one instance of Matter. Stated in the section on the semantic alignment of core classes in the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dpp#MaterialComposition> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/product/Composition> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Composition" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "MaterialComposition" ;
    sssom:subject_type owl:Class .

<http://w3id.org/dpp#Material> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/material/Material> .

<http://w3id.org/dpp#MaterialComposition> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/product/Composition> .

<http://w3id.org/dpp#hasComponent> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://w3id.org/CEON/ontology/product/hasProductComponent> .

<http://w3id.org/CEON/ontology/material/Material> a owl:Class .

<http://w3id.org/CEON/ontology/product/Composition> a owl:Class .

<http://w3id.org/CEON/ontology/product/hasProductComponent> a owl:ObjectProperty .

