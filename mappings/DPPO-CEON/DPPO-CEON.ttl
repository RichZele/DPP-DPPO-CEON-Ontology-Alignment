@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://w3id.org/dppo/ontology/dpp-info/CompositionInformation> rdfs:subClassOf [ a owl:Restriction ;
            owl:onProperty <http://w3id.org/CEON/ontology/resourceODP/isAbout> ;
            owl:someValuesFrom <http://w3id.org/CEON/ontology/product/Composition> ] .

owl:annotatedProperty a rdf:Property .

owl:annotatedSource a rdf:Property .

owl:annotatedTarget a rdf:Property .

<https://w3id.org/dpp/alignment/dppo-ceon/> a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist",
        "Huanyu Li",
        "Rahel Kebede" ;
    dcterms:created "2026-01-23"^^xsd:date ;
    dcterms:creator "Rahel Kebede" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:source "https://github.com/RichZele/DPP-DPPO-CEON-Ontology-Alignment/blob/main/mappings/DPPO-CEON.xlsx" ;
    dcterms:title "The alignment ontology between DPPO and CEON" ;
    rdfs:comment "This ontology represents the alignment between the Digital Product Passport Ontology (DPPO) and Circular Economy Ontology Network (CEON)." ;
    owl:versionInfo "0.1" .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0002> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0002" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "DPPO defines Material as a subclass of Product, by its commercial status. CEON defines Material as a subclass of Matter, requiring at least one associated chemical entity. The two are not interchangeable, so the DPPO class is aligned as a subclass of the CEON one rather than equated with it. The DPP material class is related to the same CEON class separately, which is how the two source material classes are mediated without a direct correspondence between them. Stated in the section on the semantic alignment of core classes in the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-core/Material> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/material/Material> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Material" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Material" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0003> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0003" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "DPPO uses Substance for basic chemical entities (elements or compounds) that might appear in a product’s composition or as regulated substances. CEON explicitly defines ChemicalSubstance and ChemicalElement classes. This can be seen as a specialization of DPPO's Substance class." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/CEON/ontology/material/ChemicalSubstance> ;
    owl:annotatedTarget <http://w3id.org/dppo/ontology/dpp-core/Substance> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Substance" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "ChemicalSubstance" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0004> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0004" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "CEON does not have built-in classes for “substance of concern,” but DPPO defines these as special Substance subclasses per EU regulation. We align this by treating DPPO’s concern subclasses as subclasses of CEON’s ChemicalEntity or ChemicalSubstance. For example, map dppo:ToxicSubstance as subclass of ceon-material:ChemicalSubstance, and similarly for others. This maintains the intent (they are chemical substances) within CEON’s structure. The alignment type is partial: it introduces new specialization in CEON’s hierarchy. CEON’s material module can accommodate this extension (it was designed to be extended for domain-specific material classes). The mapping is justified because it enriches CEON with DPPO’s regulatory nuance – something CEON currently lacks. Conversely, from a CEON perspective, one could treat these alignments as annotations (e.g., link a substance to an external regulatory classification). But for ontology alignment, subclassing is straightforward and retains semantics (any DPP ToxicSubstance is a CEON ChemicalSubstance with an added property “is toxic” or simply by class membership)." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-comp/SubstanceOfConcern> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/material/ChemicalEntity> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "ChemicalEntity" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "SubstanceOfConcern" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0005> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0005" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "DPPO uses one generic hasPart for products; CEON splits into model- and item-level shortcuts. Making both CEON properties subproperties of DPPO’s hasPart preserves DPPO queries and CEON’s extra precision. DPPO also infers partonomy from reified composition (see below)." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <http://w3id.org/CEON/ontology/product/hasProductComponent> ;
    owl:annotatedTarget <http://w3id.org/dppo/ontology/dpp-odp/hasPart> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "hasPart" ;
    sssom:object_type owl:ObjectProperty ;
    sssom:subject_label "hasProductComponent" ;
    sssom:subject_type owl:ObjectProperty .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0006> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0006" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <http://w3id.org/CEON/ontology/product/hasProductObjectComponent> ;
    owl:annotatedTarget <http://w3id.org/dppo/ontology/dpp-odp/hasPart> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "hasPart" ;
    sssom:object_type owl:ObjectProperty ;
    sssom:subject_label "hasProductObjectComponent" ;
    sssom:subject_type owl:ObjectProperty .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0008> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0008" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-core/Component> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/product/Product> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Product" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Component" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0010> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0010" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "DPPO's DPPInformation is a piece of information contained in a DPP and about a product; CEON's resourceODP:Information is the general notion of information about a resource. Stated in the Digital Product Passport as Document section of the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-info/DPPInformation> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/resourceODP/Information> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Information" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "DPPInformation" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0011> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0011" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "DPPO relates a DPP to the pieces of information it contains; the CEON property is the general containment relation between a collection of information and its parts. Stated in the Digital Product Passport as Document section of the accompanying paper." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-info/containsInformation> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/resourceODP/containsInformation> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "containsInformation" ;
    sssom:object_type owl:ObjectProperty ;
    sssom:subject_label "containsInformation" ;
    sssom:subject_type owl:ObjectProperty .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0012> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0012" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "Expressed as a subsumption rather than an equivalence to prevent unintended inferences arising from the domain restriction of dpp-odp:describes. Stated in the Digital Product Passport as Document section of the accompanying paper." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-odp/describes> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/resourceODP/isAbout> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "isAbout" ;
    sssom:object_type owl:ObjectProperty ;
    sssom:subject_label "describes" ;
    sssom:subject_type owl:ObjectProperty .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0013> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0013" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "Generalises DPPO_CEON_0012: dpp-odp:describes is declared a subproperty of dpp-info:isAbout within DPPO, and both isAbout properties relate a piece of information to the entity it describes. Additional mapping, not discussed in the paper." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-info/isAbout> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/resourceODP/isAbout> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "isAbout" ;
    sssom:object_type owl:ObjectProperty ;
    sssom:subject_label "isAbout" ;
    sssom:subject_type owl:ObjectProperty .

<https://w3id.org/dpp/alignment/dppo-ceon/DPPO_CEON_0015> a sssom:Mapping ;
    dc:identifier "DPPO_CEON_0015" ;
    dcterms:source "https://w3id.org/dpp/alignment/dppo-ceon/" ;
    rdfs:comment "CEON defines no passport class. Interpreted within the CEON framework the DPPO passport is a specialised information entity, so it is aligned as a subclass of the CEON information class. An equivalence would be incorrect, because the CEON class covers far more than passports. Stated in the section on the semantic alignment of core classes in the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dppo/ontology/dpp-odp/DPP> ;
    owl:annotatedTarget <http://w3id.org/CEON/ontology/resourceODP/Information> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Information" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "DPP" ;
    sssom:subject_type owl:Class .

<http://w3id.org/CEON/ontology/material/ChemicalSubstance> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dppo/ontology/dpp-core/Substance> .

<http://w3id.org/CEON/ontology/product/hasProductComponent> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://w3id.org/dppo/ontology/dpp-odp/hasPart> .

<http://w3id.org/CEON/ontology/product/hasProductObjectComponent> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://w3id.org/dppo/ontology/dpp-odp/hasPart> .

<http://w3id.org/dppo/ontology/dpp-comp/SubstanceOfConcern> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/material/ChemicalEntity> .

<http://w3id.org/dppo/ontology/dpp-core/Component> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/product/Product> .

<http://w3id.org/dppo/ontology/dpp-core/Material> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/material/Material> .

<http://w3id.org/dppo/ontology/dpp-info/DPPInformation> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/resourceODP/Information> .

<http://w3id.org/dppo/ontology/dpp-info/containsInformation> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://w3id.org/CEON/ontology/resourceODP/containsInformation> .

<http://w3id.org/dppo/ontology/dpp-info/isAbout> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://w3id.org/CEON/ontology/resourceODP/isAbout> .

<http://w3id.org/dppo/ontology/dpp-odp/DPP> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/CEON/ontology/resourceODP/Information> .

<http://w3id.org/dppo/ontology/dpp-odp/describes> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://w3id.org/CEON/ontology/resourceODP/isAbout> .

<http://w3id.org/CEON/ontology/material/ChemicalEntity> a owl:Class .

<http://w3id.org/CEON/ontology/material/Material> a owl:Class .

<http://w3id.org/CEON/ontology/product/Product> a owl:Class .

<http://w3id.org/CEON/ontology/resourceODP/containsInformation> a owl:ObjectProperty .

<http://w3id.org/dppo/ontology/dpp-core/Substance> a owl:Class .

<http://w3id.org/CEON/ontology/resourceODP/Information> a owl:Class .

<http://w3id.org/dppo/ontology/dpp-odp/hasPart> a owl:ObjectProperty .

<http://w3id.org/CEON/ontology/resourceODP/isAbout> a owl:ObjectProperty .

