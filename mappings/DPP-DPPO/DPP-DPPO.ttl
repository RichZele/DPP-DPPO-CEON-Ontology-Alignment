@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix semapv: <https://w3id.org/semapv/vocab/> .
@prefix sssom: <https://w3id.org/sssom/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

owl:annotatedProperty a rdf:Property .

owl:annotatedSource a rdf:Property .

owl:annotatedTarget a rdf:Property .

<https://w3id.org/dpp/alignment/dpp-dppo/> a owl:Ontology ;
    dcterms:contributor "Eva Blomqvist",
        "Huanyu Li",
        "Rahel Kebede" ;
    dcterms:created "2026-01-23"^^xsd:date ;
    dcterms:creator "Rahel Kebede" ;
    dcterms:license "https://creativecommons.org/licenses/by/4.0/" ;
    dcterms:source "https://github.com/RichZele/DPP-DPPO-CEON-Ontology-Alignment/blob/main/documentations/DPP-DPPO.xlsx" ;
    dcterms:title "The alignment ontology between DPP ontology and DPPO" ;
    rdfs:comment "This ontology represents the alignment between the Digital Product Passport (DPP) ontology and Digital Product Passport Ontology (DPPO)." ;
    owl:versionInfo "0.1" .

<https://w3id.org/dpp/alignment/dpp-dppo/DPP_DPPO_0002> a sssom:Mapping ;
    dc:identifier "DPP_DPPO_0002" ;
    dcterms:source "https://w3id.org/dpp/alignment/dpp-dppo/" ;
    rdfs:comment "DPPO defines a component as a product that is itself a component of another product, and places material and substance under product as well, so a DPPO component may at the same time be a DPPO material or substance. The DPP ontology places its component class under dpp:Product and keeps dpp:Material in a branch coordinate with it under dpp:PhysicalEntity, so a DPP component is not a material. The DPP class is therefore the narrower of the two and is aligned as a subclass rather than equated. Stated in the section on the semantic alignment of core classes in the accompanying paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dpp#Component> ;
    owl:annotatedTarget <http://w3id.org/dppo/ontology/dpp-core/Component> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Component" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Component" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dpp-dppo/DPP_DPPO_0005> a sssom:Mapping ;
    dc:identifier "DPP_DPPO_0005" ;
    dcterms:source "https://w3id.org/dpp/alignment/dpp-dppo/" ;
    rdfs:comment "For product-level roles, keep DPP’s AgentRole on dpp:Product; additionally mint DPPO responsibleActor on each DPPInformation item to meet DPPO’s auditability." ;
    owl:annotatedProperty owl:equivalentClass ;
    owl:annotatedSource <http://w3id.org/dpp#Agent> ;
    owl:annotatedTarget <http://w3id.org/dppo/ontology/dpp-prov/Actor> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "Actor" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Agent" ;
    sssom:subject_type owl:Class .

<https://w3id.org/dpp/alignment/dpp-dppo/DPP_DPPO_0006> a sssom:Mapping ;
    dc:identifier "DPP_DPPO_0006" ;
    dcterms:source "https://w3id.org/dpp/alignment/dpp-dppo/" ;
    rdfs:comment "DPP asserts partonomy directly at the product level through dpp:hasComponent (domain dpp:Product, range dpp:Component), whereas DPPO uses the generic dpp-odp:hasPart. The DPP property is therefore a specialisation of the DPPO one. Stated in the Product Component and Partonomy Alignment section of the accompanying paper." ;
    owl:annotatedProperty rdfs:subPropertyOf ;
    owl:annotatedSource <http://w3id.org/dpp#hasComponent> ;
    owl:annotatedTarget <http://w3id.org/dppo/ontology/dpp-odp/hasPart> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "hasPart" ;
    sssom:object_type owl:ObjectProperty ;
    sssom:subject_label "hasComponent" ;
    sssom:subject_type owl:ObjectProperty .

<https://w3id.org/dpp/alignment/dpp-dppo/DPP_DPPO_0007> a sssom:Mapping ;
    dc:identifier "DPP_DPPO_0007" ;
    dcterms:source "https://w3id.org/dpp/alignment/dpp-dppo/" ;
    rdfs:comment "DPPO defines ValueChainActor as an actor that is an active participant of the value chain of a product, explicitly exemplified by a manufacturer. dpp:Manufacturer, an entity responsible for producing products, components or materials, is therefore a specialisation. Additional mapping, not discussed in the paper." ;
    owl:annotatedProperty rdfs:subClassOf ;
    owl:annotatedSource <http://w3id.org/dpp#Manufacturer> ;
    owl:annotatedTarget <http://w3id.org/dppo/ontology/dpp-prov/ValueChainActor> ;
    sssom:mapping_justification semapv:ManualMappingCuration ;
    sssom:object_label "ValueChainActor" ;
    sssom:object_type owl:Class ;
    sssom:subject_label "Manufacturer" ;
    sssom:subject_type owl:Class .

<http://w3id.org/dpp#Agent> a owl:Class ;
    owl:equivalentClass <http://w3id.org/dppo/ontology/dpp-prov/Actor> .

<http://w3id.org/dpp#Component> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dppo/ontology/dpp-core/Component> .

<http://w3id.org/dpp#Manufacturer> a owl:Class ;
    rdfs:subClassOf <http://w3id.org/dppo/ontology/dpp-prov/ValueChainActor> .

<http://w3id.org/dpp#hasComponent> a owl:ObjectProperty ;
    rdfs:subPropertyOf <http://w3id.org/dppo/ontology/dpp-odp/hasPart> .

<http://w3id.org/dppo/ontology/dpp-core/Component> a owl:Class .

<http://w3id.org/dppo/ontology/dpp-odp/hasPart> a owl:ObjectProperty .

<http://w3id.org/dppo/ontology/dpp-prov/Actor> a owl:Class .

<http://w3id.org/dppo/ontology/dpp-prov/ValueChainActor> a owl:Class .

